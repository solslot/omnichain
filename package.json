{
  "name": "omnichain",
  "version": "1.0.0",
  "description": "SolSlot CCIP-to-Warp omnichain escrow contracts",
  "private": true,
  "main": "hardhat.config.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "hardhat compile",
    "build:warp-artifacts": "node scripts/build-pinned-warp-artifacts.js",
    "clean": "hardhat clean",
    "test": "hardhat test test/*.test.js",
    "test:coverage": "hardhat coverage",
    "deploy": "hardhat run scripts/deploy-omnichain.js",
    "deploy:warp-portal": "hardhat run scripts/deploy-warp-portal.js",
    "preflight:testnet": "hardhat run scripts/preflight-testnet-deployment.js",
    "deploy:governance": "hardhat run scripts/deploy-authority-v3-governance.js",
    "attest:activation": "hardhat run scripts/attest-omnichain-activation.js",
    "prepare:ownership": "hardhat run scripts/prepare-ownership-activation.js",
    "prepare:ownership-safe": "hardhat run scripts/prepare-ownership-safe-operation.js",
    "submit:ownership-safe": "hardhat run scripts/submit-ownership-safe-operation.js",
    "relay:escrow": "hardhat run scripts/relay-escrow-deposits.js",
    "rehearse:escrow": "hardhat run scripts/rehearse-escrow-settlement.js",
    "prepare:launch-rehearsal": "node scripts/prepare-launch-rehearsal-config.js",
    "serve:launch-rehearsal": "node scripts/serve-launch-rehearsal.js",
    "configure:gateway": "hardhat run scripts/configure-gateway.js",
    "check:config": "node scripts/check-config.js",
    "check:network": "hardhat run scripts/check-network.js",
    "security:slither": "slither . --filter-paths 'EscrowVault.sol|NftRedemption.sol|contracts/test|node_modules' --exclude-dependencies --exclude reentrancy-balance,reentrancy-eth,timestamp,low-level-calls"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solomonslot/omnichain.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/solomonslot/omnichain/issues"
  },
  "homepage": "https://github.com/solomonslot/omnichain#readme",
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@chainlink/contracts-ccip": "1.6.4",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-4.8.3": "npm:@openzeppelin/contracts@4.8.3",
    "@openzeppelin/contracts-5.0.2": "npm:@openzeppelin/contracts@5.0.2",
    "@safe-global/protocol-kit": "8.0.4",
    "dotenv": "16.5.0",
    "hardhat": "2.28.0",
    "hardhat-preprocessor": "0.1.5"
  }
}
